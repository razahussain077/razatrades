# Vercel production settings (server-only; never prefix secrets with NEXT_PUBLIC_)
WORKER_API_URL=https://your-worker.onrender.com
DASHBOARD_API_TOKEN=copy-the-private-token-from-render
DASHBOARD_PASSWORD=use-a-long-unique-password-at-least-12-characters
SESSION_SECRET=generate-a-random-secret-of-at-least-32-characters
APP_ORIGIN=https://swiftlabor-forex-intelligence-app.vercel.app

# Render worker settings (these are provisioned through render.yaml)
# DATABASE_URL=managed-automatically-from-render-postgres
# BRIDGE_TOKEN=generated-automatically-by-render
# DASHBOARD_API_TOKEN=generate-a-random-token-and-use-the-same-value-in-vercel
# TENANT_ID=equiti-client
# SCAN_INTERVAL_SECONDS=15
# STALE_AFTER_SECONDS=180
# MAX_QUOTE_AGE_SECONDS=300
# MAX_BARS_PER_STREAM=200
# RETENTION_DAYS=90

# Optional on Render: Vercel AI Gateway key + exact provider/model ID.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=


# External cross-asset FX reference feed (server-only; optional)
# auto prefers OANDA when OANDA_TOKEN is set, otherwise Massive when configured.
REFERENCE_PROVIDER=auto
REFERENCE_POLL_SECONDS=60
REFERENCE_CANDLE_COUNT=2500
MAX_REFERENCE_AGE_SECONDS=900
OANDA_ENV=practice
OANDA_TOKEN=
# Optional override only when explicitly required by your OANDA account.
# OANDA_BASE_URL=
MASSIVE_API_KEY=
# Optional legacy name for the same Massive (formerly Polygon) key.
POLYGON_API_KEY=
MASSIVE_BASE_URL=https://api.massive.com
# Exact Equiti MT5 Market Watch symbol; leave blank until verified.
# Attach SwiftLaborBridge with InpTimeframe=PERIOD_M5 and include this symbol.
DXY_MT5_SYMBOL=
